# =============================================================================
# Ask Scholar backend — environment variables (merged: API + RAG)
# =============================================================================

# --- Supabase Postgres connection -------------------------------------
# Get this from Supabase Dashboard -> Project Settings -> Database
# -> "Connection string" -> URI (choose the "Transaction pooler" one,
# port 6543, for serverless/short-lived connections; use the direct
# 5432 connection if you disable pgbouncer). Must start with
# postgresql+asyncpg:// (NOT postgresql:// or postgres://) because we
# use SQLAlchemy's async engine with the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Supabase project (used for Storage, e.g. scholar profile pictures) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key (Project Settings -> API -> service_role). Keep secret,
# server-side only. Used to upload pictures to Supabase Storage.
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=scholar-pictures

# --- Auth / JWT ---------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# --- CORS ----------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# --- Server ---------------------------------------------------------------
PORT=5000

# --- Auto-seeded admin (created once on first startup if no admin exists) -
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@askscholar.com
ADMIN_PASSWORD=change-this-password

# =============================================================================
# RAG (app/rag) — powers /api/rag/* and the video-answer lookup inside
# POST /api/scholars/askQuestion/{id}. Optional: the rest of the API works
# fine without these set, RAG search/ingestion just no-ops until they are.
# =============================================================================

# --- Gemini (transcription + embeddings) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Pinecone (vector storage) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIMENSION=768

# --- Retry / backoff tuning (optional) ---
MAX_RETRIES_PER_KEY_ROUND=6
RATE_LIMIT_SLEEP_SECS=15
RATE_LIMIT_BACKOFF=1.6

# --- Chunking (optional) ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
